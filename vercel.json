{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api": {
      "root": "xinceutong-server",
      "entrypoint": "app.main:app"
    },
    "web": {
      "root": "xinceutong-miniapp",
      "framework": "vite",
      "buildCommand": "VITE_API_BASE_URL=https://20260907155240.vercel.app npm install --no-audit --no-fund && npx uni build -p h5",
      "outputDirectory": "dist/build/h5"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ],
  "env": {
    "ENV": "production",
    "DEBUG": "false",
    "REDIS_DISABLED": "1",
    "CORS_ORIGINS": "[\"*\"]",
    "ASSESSMENT_BASE_PRICE": "9.99",
    "FREE_TRIAL_PER_USER": "1"
  }
}
