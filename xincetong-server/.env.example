# ===================== 应用基础 =====================
APP_NAME=xincetong
ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# ===================== MySQL =====================
# 本地开发对应 docker-compose 中的服务名
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=xincetong
MYSQL_PASSWORD=xincetong
MYSQL_DATABASE=xincetong
MYSQL_CHARSET=utf8mb4

# ===================== Redis =====================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_MAX_CONNECTIONS=20

# ===================== JWT =====================
# 生产请用 openssl rand -hex 32 生成
JWT_SECRET=change-me-in-production-please-use-32-bytes-random
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# ===================== 微信小程序 =====================
WECHAT_APPID=wx0000000000000000
WECHAT_SECRET=
WECHAT_MCH_ID=
WECHAT_PAY_KEY=
WECHAT_PAY_NOTIFY_URL=https://api.example.com/api/order/notify
WECHAT_PAY_CERT_PATH=./certs/apiclient_cert.pem
WECHAT_PAY_KEY_PATH=./certs/apiclient_key.pem

# ===================== 业务开关 =====================
ASSESSMENT_BASE_PRICE=9.99
PROMOTER_PRICE_MIN=6.99
PROMOTER_PRICE_MAX=19.99
PROMOTER_COMMISSION_RATE=0.30
FREE_TRIAL_PER_USER=1
FREE_TRIAL_INVITE_LIMIT=10

# ===================== 风控 / 防刷 =====================
RATE_LIMIT_PER_MIN=30
RATE_LIMIT_PER_HOUR=200

# ===================== CORS =====================
# 生产请替换为具体域名
CORS_ORIGINS=["*"]

# ===================== 日志 =====================
LOG_LEVEL=INFO
LOG_DIR=./logs
